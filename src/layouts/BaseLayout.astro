---
import { PROFILE } from '../data/siteData';

export interface Props {
  title: string;
  description: string;
  lang?: 'zh-CN' | 'en';
  currentPath?: string;
  switchHref?: string;
  wide?: boolean;
}

const {
  title,
  description,
  lang = 'zh-CN',
  currentPath = '/',
  switchHref = '/en/',
  wide = false,
} = Astro.props;

const isEn = lang === 'en';
const homeHref = isEn ? '/en/' : '/';
const projectsHref = isEn ? '/en/projects/' : '/projects/';
const essaysHref = isEn ? '/en/essays/' : '/essays/';
const resumeHref = isEn ? '/en/resume/' : '/resume/';
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Du Lei RSS" href="/rss.xml" />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('magicui-theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-elevated: #fafafa;
        --card: #ffffff;
        --card-hover: #fafafa;
        --fg: #09090b;
        --body: #3f3f46;
        --muted: #71717a;
        --subtle: #a1a1aa;
        --border: #e4e4e7;
        --border-strong: #d4d4d8;
        --pill-bg: #18181b;
        --pill-fg: #fafafa;
        --tag-bg: #f4f4f5;
        --tag-fg: #27272a;
        --dock-bg: rgba(255, 255, 255, 0.78);
        --dock-border: rgba(228, 228, 231, 0.9);
        --dock-shadow: 0 12px 32px -8px rgba(9, 9, 11, 0.12), 0 2px 6px rgba(9, 9, 11, 0.05);
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
        --card-shadow-hover: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 4px 10px -4px rgba(0, 0, 0, 0.04);
        --accent-green: #10b981;
      }

      html.dark {
        --bg: #09090b;
        --bg-elevated: #121215;
        --card: #111114;
        --card-hover: #18181c;
        --fg: #fafafa;
        --body: #d4d4d8;
        --muted: #a1a1aa;
        --subtle: #71717a;
        --border: #27272a;
        --border-strong: #3f3f46;
        --pill-bg: #fafafa;
        --pill-fg: #09090b;
        --tag-bg: #1f1f23;
        --tag-fg: #e4e4e7;
        --dock-bg: rgba(18, 18, 22, 0.78);
        --dock-border: rgba(63, 63, 70, 0.7);
        --dock-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.65), 0 2px 8px rgba(0, 0, 0, 0.4);
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
        --card-shadow-hover: 0 12px 28px -6px rgba(0, 0, 0, 0.55);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "Geist", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .mono {
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }

      .page-shell {
        max-width: 720px;
        margin: 0 auto;
        padding: 64px 24px 132px;
      }

      .page-shell.wide {
        max-width: 880px;
      }

      @media (max-width: 640px) {
        .page-shell {
          padding: 40px 18px 120px;
        }
      }

      /* MagicUI Blur-Fade Entrance */
      @keyframes blurFadeIn {
        from {
          opacity: 0;
          filter: blur(6px);
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          filter: blur(0);
          transform: translateY(0);
        }
      }

      .magic-section {
        animation: blurFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        margin-bottom: 48px;
      }

      .delay-1 { animation-delay: 0.04s; }
      .delay-2 { animation-delay: 0.10s; }
      .delay-3 { animation-delay: 0.16s; }
      .delay-4 { animation-delay: 0.22s; }
      .delay-5 { animation-delay: 0.28s; }
      .delay-6 { animation-delay: 0.34s; }

      .section-title {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0 0 16px;
        color: var(--fg);
      }

      .section-pill {
        display: inline-block;
        background: var(--pill-bg);
        color: var(--pill-fg);
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 999px;
        letter-spacing: 0.02em;
        margin-bottom: 12px;
      }

      .section-header-center {
        text-align: center;
        margin-bottom: 32px;
      }

      .section-header-center h2 {
        font-size: clamp(26px, 4.5vw, 36px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.18;
        margin: 0 0 10px;
      }

      .section-header-center p {
        color: var(--muted);
        font-size: 15px;
        max-width: 540px;
        margin: 0 auto;
      }

      /* Prose for subpages */
      .prose h1 {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.25;
        margin: 0 0 12px;
      }
      .prose h3 {
        font-size: 17px;
        font-weight: 700;
        margin: 28px 0 10px;
        color: var(--fg);
      }
      .prose p, .prose li {
        font-size: 15px;
        color: var(--body);
        line-height: 1.75;
      }
      .prose ul {
        padding-left: 20px;
      }
      .prose li {
        margin-bottom: 8px;
      }
      .prose pre {
        background: #0d0d10;
        color: #e4e4e7;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 14px 16px;
        overflow-x: auto;
        font-size: 13px;
      }

      /* Floating Apple-Style MagicUI Dock */
      .dock-wrapper {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        pointer-events: none;
      }

      .magic-dock {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 7px 10px;
        background: var(--dock-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--dock-border);
        border-radius: 999px;
        box-shadow: var(--dock-shadow);
      }

      .dock-divider {
        width: 1px;
        height: 22px;
        background: var(--border);
        margin: 0 4px;
      }

      .dock-item {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--body);
        background: transparent;
        border: none;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.15s ease, color 0.15s ease;
      }

      .dock-item:hover {
        transform: translateY(-4px) scale(1.15);
        background: var(--tag-bg);
        color: var(--fg);
      }

      .dock-item.active {
        background: var(--tag-bg);
        color: var(--fg);
      }

      .dock-tooltip {
        position: absolute;
        bottom: 48px;
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        background: var(--pill-bg);
        color: var(--pill-fg);
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 6px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s ease, transform 0.15s ease;
      }

      .dock-item:hover .dock-tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .lang-badge {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      @media print {
        .dock-wrapper {
          display: none !important;
        }
        .page-shell {
          padding: 0 !important;
          max-width: 100% !important;
        }
      }
    </style>
  </head>
  <body>
    <main class={`page-shell ${wide ? 'wide' : ''}`}>
      <slot />
    </main>

    <!-- MagicUI Floating Bottom Dock -->
    <div class="dock-wrapper" role="navigation" aria-label="Primary Dock">
      <div class="magic-dock">
        <a href={homeHref} class={`dock-item ${currentPath === '/' ? 'active' : ''}`} aria-label="Home">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="dock-tooltip">{isEn ? 'Home' : '主页'}</span>
        </a>

        <a href={projectsHref} class={`dock-item ${currentPath === '/projects' ? 'active' : ''}`} aria-label="Projects">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span class="dock-tooltip">{isEn ? 'Projects' : '开源项目'}</span>
        </a>

        <a href={essaysHref} class={`dock-item ${currentPath === '/essays' ? 'active' : ''}`} aria-label="Essays">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span class="dock-tooltip">{isEn ? 'Field Notes' : '工程复盘'}</span>
        </a>

        <a href={resumeHref} class={`dock-item ${currentPath === '/resume' ? 'active' : ''}`} aria-label="Resume">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2"/><path d="M15 12h2"/><path d="M7 16h10"/></svg>
          <span class="dock-tooltip">{isEn ? 'Resume' : '在线简历'}</span>
        </a>

        <div class="dock-divider"></div>

        <a href={PROFILE.githubUrl} target="_blank" rel="noopener" class="dock-item" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <span class="dock-tooltip">GitHub</span>
        </a>

        <div class="dock-divider"></div>

        <a href={switchHref} class="dock-item" aria-label="Switch Language">
          <span class="lang-badge">{isEn ? '中' : 'EN'}</span>
          <span class="dock-tooltip">{isEn ? '切换中文' : 'English'}</span>
        </a>

        <button type="button" id="theme-toggle" class="dock-item" aria-label="Toggle Theme">
          <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <span class="dock-tooltip">{isEn ? 'Theme' : '明暗主题'}</span>
        </button>
      </div>
    </div>

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        function syncIcons() {
          const isDark = document.documentElement.classList.contains('dark');
          if (sun && moon) {
            sun.style.display = isDark ? 'block' : 'none';
            moon.style.display = isDark ? 'none' : 'block';
          }
        }
        syncIcons();
        if (btn) {
          btn.addEventListener('click', function () {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('magicui-theme', isDark ? 'dark' : 'light');
            syncIcons();
            btn.blur();
          });
        }
      })();
    </script>
  </body>
</html>
